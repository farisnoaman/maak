{
  "name": "maak",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:functions": "node scripts/build-functions.mjs",
    "check:functions": "node scripts/build-functions.mjs --check",
    "dev": "npm --workspace @maak/web run dev",
    "check:guards": "node scripts/check-guards.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
