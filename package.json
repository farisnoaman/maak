{
  "name": "maak",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:functions": "node scripts/build-functions.mjs",
    "check:functions": "node scripts/build-functions.mjs --check",
    "dev": "npm --workspace @maak/web run dev",
    "check:guards": "node scripts/check-guards.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "node scripts/db-types.mjs --write",
    "db:types:check": "node scripts/db-types.mjs --check",
    "test:coverage": "npm --workspace @maak/core run test:coverage",
    "check:a11y": "node scripts/check-a11y.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "esbuild": "^0.28.2",
    "node-html-parser": "^9.0.5",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "@eslint/js": "^10.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
