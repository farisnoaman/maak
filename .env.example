# ---------------------------------------------------------------------------
# Maak environment
# Copy to .env.local (web) and set the same values in your Supabase project.
# Nothing here is a secret that may be committed: this file documents the shape only.
# ---------------------------------------------------------------------------

# Public: safe to expose to the browser. RLS protects everything these keys can reach.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by Edge Functions; NEVER exposed to a client bundle (CI greps for it).
SUPABASE_SERVICE_ROLE_KEY=

# CORS allow-list for the write gateway (comma separated, no wildcards).
MAAK_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional observability. Leave empty to disable reporting entirely.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Optional: WhatsApp share links and email sender (Phase 9/11)
MAAK_SUPPORT_WHATSAPP=
RESEND_API_KEY=
