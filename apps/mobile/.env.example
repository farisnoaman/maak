# The mobile app's environment — copy to `.env` in this folder.
#
# These four are read at *build* time (`EXPO_PUBLIC_*` is inlined into the bundle, so changing one means a new
# build, not a reload) and the first two are the difference between an app that works and an app that installs
# and then says "not configured".
#
#   cp apps/mobile/.env.example apps/mobile/.env
#
# For EAS cloud builds do NOT commit a `.env`: create the same names once per environment
# (`eas env:create --environment preview --name EXPO_PUBLIC_SUPABASE_URL ...`). `eas.json` names an environment
# per profile, so the build picks them up.

# The Supabase project the app talks to. On a *physical* phone, `127.0.0.1` is the phone itself — use the
# machine running `npm run dev:api` and its LAN address, e.g. http://192.168.1.20:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The anon key. It is public by design (RLS is what protects the data); the service key must never appear here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=maak-dev-anon-key

# The web origin, used by "share this trip" links and by the staff scanner. Optional.
EXPO_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_WEB_URL=http://localhost:3000
